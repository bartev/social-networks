{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format current notebook with nbqa black",
            "type": "shell",
            "command": "uv run nbqa black \"${file}\"",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Lint current notebook with nbqa ruff",
            "type": "shell",
            "command": "uv run nbqa ruff \"${file}\" --fix",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Format and lint current notebook",
            "dependsOn": [
                "Format current notebook with nbqa black",
                "Lint current notebook with nbqa ruff"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        }
    ]
}